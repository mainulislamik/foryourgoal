# FORYOURGOAL Production Environment Variables (.env.example)

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://foryourgoal.com
NEXT_PUBLIC_SITE_NAME=Foryourgoal
NEXT_PUBLIC_CONTACT_EMAIL=contact@foryourgoal.com
NEXT_PUBLIC_PHONE=+8801700000000

# Transactional Email / SMTP
SMTP_HOST=mail.foryourgoal.com
SMTP_PORT=587
SMTP_USER=contact@foryourgoal.com
SMTP_PASS=[REDACTED]
COMPANY_NOTIFICATION_EMAIL=info@foryourgoal.com

# S3 / Cloudflare R2 Storage (For Sample Image Uploads)
R2_ACCOUNT_ID=[REDACTED]
R2_ACCESS_KEY_ID=[REDACTED]
R2_SECRET_ACCESS_KEY=[REDACTED]
R2_BUCKET_NAME=foryourgoal-client-assets
R2_PUBLIC_URL=https://assets.foryourgoal.com

# Database (PostgreSQL / SQLite)
DATABASE_URL=postgresql://foryourgoal_user:[REDACTED]@172.17.0.1:5432/foryourgoal_db
